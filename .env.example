# Origen permitido por CORS en todos los microservicios.
FRONTEND_ORIGIN=http://localhost:5173

# Microservicio de productos (catálogo de la tienda).
VITE_API_BASE_URL=http://localhost:8081

# Resto de microservicios. Deja una variable vacía para que esa sección
# de la tienda siga funcionando en modo local (datos del navegador).
VITE_USUARIOS_API_URL=http://localhost:8082
VITE_PEDIDOS_API_URL=http://localhost:8083
VITE_CONTACTO_API_URL=http://localhost:8084
VITE_PAGOS_API_URL=http://localhost:8085

# Credenciales del administrador inicial de ms-usuarios. ¡Cámbialas antes de publicar el sitio!
ADMIN_CORREO=luis.ferreteria373@gmail.com
ADMIN_CLAVE=pon-una-clave-propia
# Solo modo local (sin API): administrador sembrado en el navegador.
VITE_ADMIN_CORREO=luis.ferreteria373@gmail.com
VITE_ADMIN_CLAVE=pon-una-clave-propia

# ms-pedidos: URL de ms-productos para validar stock y descontar inventario.
# En docker-compose ya está configurada (http://ms-productos:8081); para correr
# los servicios sin Docker, exporta PRODUCTOS_URL=http://localhost:8081 al iniciar ms-pedidos.
# PRODUCTOS_URL=http://localhost:8081

# Clave con la que los 5 microservicios firman y validan los JWT (HS256).
# Debe ser IGUAL en todos y tener al menos 32 caracteres. Genera una propia, p. ej.: openssl rand -base64 48
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
# Minutos de vida del token (opcional, 60 por defecto).
# JWT_MINUTOS=60

# Perfil "mysql" (docker-compose y AWS EC2): datos de la base de datos.
# Sin Docker: DB_URL=jdbc:mysql://localhost:3306/ferreteria  DB_USER=ferreteria
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-la-clave-root
