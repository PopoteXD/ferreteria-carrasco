/* =====================================================================
   Ferretería Carrasco – Hoja de estilos
   Diseño profesional: azul corporativo + acento ámbar, tarjetas con
   sombras suaves, tipografía Inter / Poppins y diseño responsivo.
   ===================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap');

/* ---------- 1. VARIABLES ---------- */
:root {
  --azul: #3a52a0;
  --azul-oscuro: #1f2f6b;
  --azul-profundo: #131c42;
  --azul-claro: #e8ecf8;
  --acento: #f5a623;
  --acento-oscuro: #d98c0c;
  --texto: #1d2433;
  --texto-suave: #5b6478;
  --fondo: #f5f7fb;
  --blanco: #ffffff;
  --borde: #e2e6ef;
  --exito: #1f8a4c;
  --exito-fondo: #e7f6ed;
  --error: #c62828;
  --error-fondo: #fdecec;
  --aviso-fondo: #fff6e5;
  --radio: 12px;
  --radio-sm: 8px;
  --sombra-sm: 0 1px 3px rgba(19, 28, 66, 0.08);
  --sombra: 0 6px 20px rgba(19, 28, 66, 0.08);
  --sombra-lg: 0 14px 34px rgba(19, 28, 66, 0.16);
  --fuente-texto: 'Inter', 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
  --fuente-titulo: 'Poppins', 'Inter', 'Segoe UI', sans-serif;
}

/* ---------- 2. BASE ---------- */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--fuente-texto);
  background-color: var(--fondo);
  color: var(--texto);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

h1, h2, h3 {
  font-family: var(--fuente-titulo);
  color: var(--azul-profundo);
  line-height: 1.25;
  margin: 0 0 10px 0;
}

h1 { font-weight: 800; letter-spacing: -0.5px; }
h2 { font-weight: 700; }
h3 { font-weight: 600; }

:focus-visible {
  outline: 3px solid var(--acento);
  outline-offset: 2px;
}

.contenedor {
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 24px;
}

.oculto {
  display: none !important;
}

/* ---------- 3. ENCABEZADO / NAVEGACIÓN ---------- */
.encabezado {
  background: linear-gradient(135deg, var(--azul-oscuro), var(--azul));
  border-bottom: 3px solid var(--acento);
  box-shadow: var(--sombra);
  position: sticky;
  top: 0;
  z-index: 50;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  height: 72px;
}

.marca {
  color: white;
  display: flex;
  align-items: center;
  height: 100%;
}

.marca .logo {
  height: 52px;
  width: auto;
  object-fit: contain;
}

.nav-links {
  display: flex;
  gap: 4px;
  flex: 1;
  justify-content: center;
}

.nav-links a {
  color: rgba(255, 255, 255, 0.88);
  padding: 8px 16px;
  border-radius: 999px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: background-color 0.2s, color 0.2s;
}

.nav-links a:hover {
  color: white;
  background-color: rgba(255, 255, 255, 0.14);
}

.nav-acciones {
  display: flex;
  align-items: center;
  gap: 10px;
}

.nav-acciones .btn-secundario {
  border-color: rgba(255, 255, 255, 0.55);
  color: white;
}

.nav-acciones .btn-secundario:hover {
  background-color: white;
  border-color: white;
  color: var(--azul-oscuro);
}

.btn-icono {
  background-color: var(--acento);
  color: var(--azul-profundo);
  font-weight: 700;
  font-size: 0.9rem;
  padding: 9px 16px;
  border-radius: 999px;
  position: relative;
  transition: background-color 0.2s, transform 0.15s;
}

.btn-icono:hover {
  background-color: #ffb84a;
  transform: translateY(-1px);
}

.badge-carrito {
  position: absolute;
  top: -7px;
  right: -7px;
  background-color: var(--error);
  color: white;
  font-size: 0.7rem;
  font-weight: 700;
  border-radius: 50%;
  width: 21px;
  height: 21px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid white;
}

/* ---------- 4. BOTONES ---------- */
.btn {
  display: inline-block;
  padding: 11px 22px;
  border: 2px solid transparent;
  border-radius: 999px;
  font-family: var(--fuente-texto);
  font-size: 0.95rem;
  font-weight: 600;
  text-align: center;
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.15s, box-shadow 0.2s;
}

.btn:hover:not(:disabled) {
  transform: translateY(-1px);
}

.btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.btn-primario {
  background-color: var(--azul);
  color: white;
  box-shadow: 0 4px 12px rgba(58, 82, 160, 0.3);
}

.btn-primario:hover:not(:disabled) {
  background-color: var(--azul-oscuro);
  box-shadow: 0 6px 16px rgba(58, 82, 160, 0.4);
}

.btn-secundario {
  background-color: transparent;
  border-color: var(--azul);
  color: var(--azul);
}

.btn-secundario:hover:not(:disabled) {
  background-color: var(--azul);
  color: white;
}

.btn-sm {
  padding: 7px 16px;
  font-size: 0.85rem;
}

/* ---------- 5. HERO ---------- */
section.hero {
  position: relative;
  overflow: hidden;
  min-height: 520px;
  color: white;
  background: linear-gradient(135deg, var(--azul-profundo), var(--azul));
}

section.hero video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.hero-overlay {
  position: relative;
  z-index: 2;
  min-height: 520px;
  display: flex;
  align-items: center;
  background: linear-gradient(100deg, rgba(19, 28, 66, 0.92) 0%, rgba(19, 28, 66, 0.65) 55%, rgba(19, 28, 66, 0.3) 100%);
}

.hero-overlay h1 {
  color: white;
  font-size: clamp(2rem, 5vw, 3.4rem);
  max-width: 680px;
}

.hero-overlay p {
  color: rgba(255, 255, 255, 0.88);
  font-size: 1.15rem;
  max-width: 560px;
}

.hero-acciones {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.hero-acciones .btn-primario {
  background-color: var(--acento);
  color: var(--azul-profundo);
  box-shadow: 0 6px 18px rgba(245, 166, 35, 0.4);
}

.hero-acciones .btn-primario:hover:not(:disabled) {
  background-color: #ffb84a;
}

.hero-acciones .btn-secundario {
  border-color: white;
  color: white;
}

.hero-acciones .btn-secundario:hover {
  background-color: white;
  color: var(--azul-oscuro);
}

/* ---------- 6. SECCIONES ---------- */
.seccion {
  position: relative;
  z-index: 1;
  padding: 64px 0;
}

.titulo-seccion {
  margin-bottom: 32px;
  padding-bottom: 14px;
  position: relative;
  border-bottom: 1px solid var(--borde);
}

.titulo-seccion::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 72px;
  height: 4px;
  border-radius: 4px;
  background-color: var(--acento);
}

.titulo-seccion h2 {
  margin: 0;
  font-size: 1.9rem;
}

/* ---------- 7. CATEGORÍAS ---------- */
.grid-categorias {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 16px;
}

.tarjeta-categoria {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  padding: 22px 18px;
  font-family: var(--fuente-titulo);
  font-weight: 600;
  font-size: 1rem;
  color: var(--azul-oscuro);
  box-shadow: var(--sombra-sm);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s;
}

.tarjeta-categoria::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 5px;
  background-color: var(--acento);
}

.tarjeta-categoria:hover {
  transform: translateY(-4px);
  box-shadow: var(--sombra);
  border-color: var(--azul);
  color: var(--azul);
}

/* ---------- 8. PRODUCTOS ---------- */
.grid-productos {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 24px;
}

.tarjeta-producto {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: var(--sombra-sm);
  transition: transform 0.25s, box-shadow 0.25s;
}

.tarjeta-producto:hover {
  transform: translateY(-5px);
  box-shadow: var(--sombra-lg);
}

.tarjeta-producto .miniatura {
  aspect-ratio: 1 / 1;
  background-color: var(--azul-claro);
  position: relative;
  overflow: hidden;
}

.tarjeta-producto .miniatura img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}

.tarjeta-producto:hover .miniatura img {
  transform: scale(1.06);
}

.etiqueta-stock-critico {
  position: absolute;
  top: 12px;
  left: 12px;
  background-color: var(--error);
  color: white;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
}

.tarjeta-producto .cuerpo {
  padding: 18px 18px 8px;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tarjeta-producto .cuerpo h3 {
  font-size: 1.02rem;
  margin: 0 0 4px;
  min-height: 2.5em;
}

.tarjeta-producto .categoria {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--azul);
}

.tarjeta-producto .codigo,
.codigo {
  font-size: 0.8rem;
  color: var(--texto-suave);
}

.tarjeta-producto .precio {
  font-family: var(--fuente-titulo);
  font-weight: 700;
  font-size: 1.45rem;
  color: var(--azul-oscuro);
  margin-top: 8px;
}

.acciones-tarjeta {
  display: flex;
  gap: 8px;
  padding: 12px 18px 18px;
}

.acciones-tarjeta .btn {
  flex: 1;
  padding-left: 10px;
  padding-right: 10px;
}

/* ---------- 9. FORMULARIOS ---------- */
.tarjeta-formulario {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  box-shadow: var(--sombra);
  padding: 36px;
  max-width: 520px;
  margin: 0 auto;
}

.tarjeta-formulario h2 {
  margin-bottom: 22px;
}

.campo-formulario {
  margin-bottom: 18px;
}

.campo-formulario label {
  display: block;
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 6px;
  color: var(--azul-profundo);
}

.campo-formulario input,
.campo-formulario select,
.campo-formulario textarea {
  width: 100%;
  padding: 11px 14px;
  border: 1.5px solid var(--borde);
  border-radius: var(--radio-sm);
  font-family: inherit;
  font-size: 0.95rem;
  color: var(--texto);
  background-color: #fbfcfe;
  transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
}

.campo-formulario input:focus,
.campo-formulario select:focus,
.campo-formulario textarea:focus {
  outline: none;
  border-color: var(--azul);
  background-color: white;
  box-shadow: 0 0 0 4px rgba(58, 82, 160, 0.14);
}

.campo-invalido {
  border-color: var(--error) !important;
  background-color: var(--error-fondo) !important;
}

.campo-valido {
  border-color: var(--exito) !important;
}

.texto-error {
  color: var(--error);
  font-size: 0.8rem;
  margin-top: 4px;
  display: none;
}

.texto-error.visible {
  display: block;
}

.aviso {
  padding: 14px 18px;
  margin-bottom: 18px;
  border-radius: var(--radio-sm);
  border-left: 5px solid var(--acento);
  background-color: var(--aviso-fondo);
  box-shadow: var(--sombra-sm);
}

.aviso.exito {
  border-color: var(--exito);
  background-color: var(--exito-fondo);
}

.aviso.error {
  border-color: var(--error);
  background-color: var(--error-fondo);
}

/* ---------- 10. CARRITO ---------- */
.tabla-carrito {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  box-shadow: var(--sombra-sm);
  overflow: hidden;
}

.tabla-carrito th {
  text-align: left;
  background-color: var(--azul-oscuro);
  color: white;
  padding: 14px 16px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.tabla-carrito td {
  padding: 16px;
  border-bottom: 1px solid var(--borde);
  vertical-align: middle;
}

.tabla-carrito tbody tr:last-child td {
  border-bottom: none;
}

.tabla-carrito td button:not(.btn-quitar) {
  width: 32px;
  height: 32px;
  border: 1px solid var(--borde);
  background-color: var(--blanco);
  border-radius: 50%;
  font-weight: 700;
  color: var(--azul);
  cursor: pointer;
  transition: background-color 0.2s, color 0.2s;
}

.tabla-carrito td button:not(.btn-quitar):hover:not(:disabled) {
  background-color: var(--azul);
  color: white;
}

.tabla-carrito td button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-quitar {
  background: none;
  border: none;
  color: var(--error);
  font-weight: 600;
  cursor: pointer;
}

.btn-quitar:hover {
  text-decoration: underline;
}

.fila-producto-carrito {
  display: flex;
  gap: 14px;
  align-items: center;
}

.fila-producto-carrito img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  border-radius: var(--radio-sm);
  border: 1px solid var(--borde);
}

.resumen-carrito {
  background: linear-gradient(145deg, var(--azul-profundo), var(--azul-oscuro));
  color: white;
  padding: 26px;
  max-width: 360px;
  margin-left: auto;
  margin-top: 24px;
  border-radius: var(--radio);
  box-shadow: var(--sombra-lg);
}

.resumen-carrito .linea {
  display: flex;
  justify-content: space-between;
  padding: 7px 0;
  color: rgba(255, 255, 255, 0.85);
}

.resumen-carrito .linea.total {
  font-size: 1.25rem;
  font-family: var(--fuente-titulo);
  font-weight: 700;
  color: white;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  margin-top: 10px;
  padding-top: 14px;
}

.resumen-carrito .btn-primario {
  background-color: var(--acento);
  color: var(--azul-profundo);
  box-shadow: none;
}

.resumen-carrito .btn-primario:hover:not(:disabled) {
  background-color: #ffb84a;
}

.carrito-vacio {
  text-align: center;
  padding: 64px 24px;
  background-color: var(--blanco);
  border: 2px dashed var(--borde);
  border-radius: var(--radio);
}

/* ---------- 11. DETALLE, CONTACTO, NOSOTROS ---------- */
.precio-grande {
  font-family: var(--fuente-titulo);
  font-weight: 800;
  font-size: 2rem;
  color: var(--azul-oscuro);
}

.galeria img {
  border-radius: var(--radio);
  box-shadow: var(--sombra);
}

.grid-contacto-info {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.tarjeta-contacto-info {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-top: 4px solid var(--acento);
  border-radius: var(--radio);
  box-shadow: var(--sombra-sm);
  padding: 24px;
  line-height: 1.8;
}

.tarjeta-contacto-info strong {
  display: block;
  margin-bottom: 6px;
  font-size: 0.8rem;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--azul);
}

.grid-nosotros {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}

.grid-nosotros img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: var(--radio);
  box-shadow: var(--sombra-lg);
}

/* ---------- 12. PIE DE PÁGINA ---------- */
.pie {
  background-color: var(--azul-profundo);
  color: rgba(255, 255, 255, 0.7);
  padding: 48px 0 24px;
  margin-top: 40px;
  position: relative;
  z-index: 1;
}

.pie-inferior {
  text-align: center;
  font-size: 0.85rem;
  padding-top: 20px;
}

/* ---------- 13. PANEL ADMINISTRADOR ---------- */
.diseno-admin {
  display: flex;
  min-height: 100vh;
}

.admin-lateral {
  width: 250px;
  flex: none;
  background: linear-gradient(180deg, var(--azul-profundo), var(--azul-oscuro));
  color: rgba(255, 255, 255, 0.8);
  padding: 24px 0;
}

.admin-lateral .marca-admin {
  color: white;
  font-family: var(--fuente-titulo);
  font-size: 1.2rem;
  font-weight: 700;
  padding: 0 24px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  margin-bottom: 14px;
}

.admin-lateral nav a {
  display: block;
  margin: 2px 12px;
  padding: 11px 14px;
  border-radius: var(--radio-sm);
  font-size: 0.92rem;
  font-weight: 500;
  transition: background-color 0.2s, color 0.2s;
}

.admin-lateral nav a:hover {
  background-color: rgba(255, 255, 255, 0.12);
  color: white;
}

.admin-principal {
  flex: 1;
  min-width: 0;
  background-color: var(--fondo);
}

.admin-encabezado {
  background-color: var(--blanco);
  border-bottom: 1px solid var(--borde);
  box-shadow: var(--sombra-sm);
  padding: 18px 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-contenido {
  padding: 32px;
}

.tarjetas-metricas {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 18px;
  margin-bottom: 28px;
}

.tarjeta-metrica {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-top: 4px solid var(--azul);
  border-radius: var(--radio);
  box-shadow: var(--sombra-sm);
  padding: 22px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.tarjeta-metrica:hover {
  transform: translateY(-3px);
  box-shadow: var(--sombra);
}

.tarjeta-metrica:nth-child(even) {
  border-top-color: var(--acento);
}

.tarjeta-metrica strong {
  display: block;
  font-family: var(--fuente-titulo);
  font-size: 1.9rem;
  color: var(--azul-profundo);
}

.tarjeta-metrica span {
  font-size: 0.85rem;
  color: var(--texto-suave);
}

.panel-admin {
  background-color: var(--blanco);
  border: 1px solid var(--borde);
  border-radius: var(--radio);
  box-shadow: var(--sombra-sm);
  overflow-x: auto;
}

.panel-admin-cabecera {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  border-bottom: 1px solid var(--borde);
}

.tabla-admin {
  width: 100%;
  border-collapse: collapse;
}

.tabla-admin th {
  text-align: left;
  font-size: 0.73rem;
  font-weight: 600;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--texto-suave);
  padding: 12px 20px;
  border-bottom: 1px solid var(--borde);
  background-color: var(--fondo);
}

.tabla-admin td {
  padding: 14px 20px;
  border-bottom: 1px solid var(--borde);
  font-size: 0.92rem;
}

.tabla-admin tbody tr:hover {
  background-color: #f9fafe;
}

.pastilla {
  display: inline-block;
  padding: 3px 11px;
  font-size: 0.73rem;
  font-weight: 600;
  border-radius: 999px;
}

.pastilla.ok {
  background-color: var(--exito-fondo);
  color: var(--exito);
}

.pastilla.critico {
  background-color: var(--error-fondo);
  color: var(--error);
}

.acciones-tabla a,
.acciones-tabla button {
  font-size: 0.85rem;
  font-weight: 600;
  margin-right: 12px;
  color: var(--azul);
}

.acciones-tabla a:hover {
  text-decoration: underline;
}

.acciones-tabla .eliminar {
  color: var(--error);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
}

.acciones-tabla .eliminar:hover {
  text-decoration: underline;
}

/* ---------- 14. RESPONSIVO ---------- */
@media (max-width: 900px) {
  .nav {
    height: auto;
    flex-wrap: wrap;
    padding-top: 10px;
    padding-bottom: 10px;
    row-gap: 8px;
  }

  .nav-links {
    order: 3;
    width: 100%;
    flex: none;
    justify-content: flex-start;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .grid-nosotros {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .diseno-admin {
    flex-direction: column;
  }

  .admin-lateral {
    width: 100%;
    padding: 14px 0;
  }

  .admin-lateral nav {
    display: flex;
    flex-wrap: wrap;
    padding: 0 8px;
  }
}

@media (max-width: 768px) {
  .marca .logo {
    height: 40px;
  }

  .nav-acciones {
    flex-wrap: wrap;
    gap: 8px;
  }

  .seccion {
    padding: 44px 0;
  }

  section.hero,
  .hero-overlay {
    min-height: 420px;
  }

  .tarjeta-formulario {
    padding: 24px;
  }

  .tabla-carrito th,
  .tabla-carrito td {
    padding: 10px;
  }

  .admin-contenido {
    padding: 18px;
  }

  .admin-encabezado {
    padding: 14px 18px;
  }

  .resumen-carrito {
    max-width: none;
  }
}

@media (max-width: 480px) {
  .contenedor {
    padding: 0 16px;
  }

  .grid-categorias,
  .grid-productos {
    grid-template-columns: 1fr;
  }

  .hero-acciones .btn {
    flex: 1;
  }
}
